{
  "expo": {
    "name": "TrustTrip",
    "slug": "TrustTrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/app icon.png",
    "scheme": "trusttrip",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./src/assets/images/app icon.png",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/app icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.TrustTrip"
    },
    "web": {
      "output": "single"
    },
    "extra": {
      "API_BASE_URL": "http://10.0.2.2:5000",
      "APP_NAME": "TrustTrip",
      "APP_VERSION": "1.0.0",
      "REQUEST_TIMEOUT": 10000
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TrustTrip to access your location."
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
